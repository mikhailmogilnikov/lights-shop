{
  "name": "backend-product-service",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/src/index.js",
    "prisma:generate": "prisma generate --schema ./prisma/schema",
    "prisma:migrate": "prisma migrate deploy --schema ./prisma/schema",
    "db:push": "prisma db push --schema ./prisma/schema",
    "db:studio": "prisma studio",
    "seed": "bun run src/scripts/seed.ts"
  },
  "prisma": {
    "schema": "./schema"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "^0.1.8",
    "@elysiajs/swagger": "^1.3.0",
    "@hono/swagger-ui": "^0.5.1",
    "@hono/zod-validator": "^0.2.0",
    "@orpc/client": "^1.1.1",
    "@orpc/server": "^1.1.1",
    "@prisma/client": "^6.7.0",
    "dotenv": "^16.4.7",
    "elysia": "^1.3.1",
    "hono": "^4.7.6",
    "pino": "^9.7.0",
    "zod": "^3.25.46"
  },
  "devDependencies": {
    "tsc-alias": "^1.8.11",
    "typescript": "^5.8.2",
    "@types/bun": "^1.2.6",
    "prisma": "^6.7.0"
  }
}
